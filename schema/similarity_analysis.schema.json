{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M8.2 Similarity Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "retrieval", "analysis", "analysis_status", "warnings"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "case_id", "source_analysis_context", "analyzer_version", "prompt_version", "model_provider", "model_name", "generated_at"],
      "properties": {
        "query_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "source_analysis_context": {"type": "string"},
        "analyzer_version": {"type": "string"},
        "prompt_version": {"type": "string"},
        "model_provider": {"type": "string"},
        "model_name": {"type": "string"},
        "generated_at": {"type": "string"}
      }
    },
    "retrieval": {
      "type": "object", "additionalProperties": false,
      "required": ["rank", "retrieval_score"],
      "properties": {"rank": {"type": "integer", "minimum": 0}, "retrieval_score": {"type": "number"}}
    },
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["dimensions", "overall_score", "overall_level", "key_similarities", "key_differences", "evidence_gaps", "analysis_summary", "confidence"],
      "properties": {
        "dimensions": {
          "type": "object", "additionalProperties": false,
          "required": ["problem_object", "phenomenon", "trigger_condition", "impact", "failure_mechanism", "trc", "mrc", "root_cause", "classification", "organization_context"],
          "properties": {
            "problem_object": {"$ref": "#/$defs/dimension"},
            "phenomenon": {"$ref": "#/$defs/dimension"},
            "trigger_condition": {"$ref": "#/$defs/dimension"},
            "impact": {"$ref": "#/$defs/dimension"},
            "failure_mechanism": {"$ref": "#/$defs/dimension"},
            "trc": {"$ref": "#/$defs/dimension"},
            "mrc": {"$ref": "#/$defs/dimension"},
            "root_cause": {"$ref": "#/$defs/dimension"},
            "classification": {"$ref": "#/$defs/dimension"},
            "organization_context": {"$ref": "#/$defs/dimension"}
          }
        },
        "overall_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "overall_level": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
        "key_similarities": {"type": "array", "items": {"type": "string"}},
        "key_differences": {"type": "array", "items": {"type": "string"}},
        "evidence_gaps": {"type": "array", "items": {"type": "string"}},
        "analysis_summary": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "analysis_status": {"type": "string", "enum": ["SUCCESS", "SKIPPED", "AI_OUTPUT_INVALID", "AI_ANALYSIS_FAILED"]},
    "warnings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object", "additionalProperties": false,
      "required": ["score", "assessment", "query_evidence", "case_evidence", "reason"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "assessment": {"type": "string", "enum": ["HIGHLY_SIMILAR", "SIMILAR", "PARTIALLY_RELATED", "WEAKLY_RELATED", "NOT_SIMILAR", "UNKNOWN"]},
        "query_evidence": {"type": "array", "items": {"type": "string"}},
        "case_evidence": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"}
      }
    }
  }
}
