# Storage product execution layer. Product test must use runtime.
STORAGE_LIFE_EXECUTION_MODE=runtime

# Public Unified Agent Runtime checkout. Optional: launch script auto-clones pinned commit when unset.
# UNIFIED_AGENT_RUNTIME_ROOT=/path/to/ploblem_ai

# User-owned Runtime model config. Preferred real-provider configuration.
# STORAGE_MODEL_CONFIG=/path/to/model.local.yaml

# Mock fault injection: normal | 429_once | truncate_once | persistent_503
STORAGE_MOCK_FAULT=normal

# Backward-compatible CI mode only when STORAGE_MODEL_CONFIG is not used.
# DASHSCOPE_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=<secret>

# Safe provider request diagnostics. Never prints API keys or prompt/body.
RUNTIME_PROVIDER_TRACE=1
