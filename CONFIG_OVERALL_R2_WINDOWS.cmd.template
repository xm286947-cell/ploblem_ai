@echo off
rem Copy this file to CONFIG_OVERALL_R2_WINDOWS.cmd before first startup.
rem Bind the approved EXISTING Legacy Quality Issue database. The package will
rem validate it read-only and will NOT create or migrate a substitute database.
set "LEGACY_QUALITY_ISSUE_DB_PATH=C:\REPLACE\WITH\APPROVED\quality_issue_v1.db"

rem Optional. Default: %LOCALAPPDATA%\OverallR2\data
rem set "OVERALL_R2_DATA_DIR=D:\QualityPlatform\OverallR2\data"

rem Optional. Default: %OVERALL_R2_DATA_DIR%\quality_capability_p1.db
rem set "OVERALL_R2_P1_DB=D:\QualityPlatform\OverallR2\data\quality_capability_p1.db"

rem Optional. Default: %OVERALL_R2_DATA_DIR%\storage
rem set "STORAGE_LIFE_DATA_DIR=D:\QualityPlatform\OverallR2\data\storage"

rem Optional persistent Storage Runtime / Knowledge locations.
rem Defaults are all under %OVERALL_R2_DATA_DIR% and therefore survive package replacement.
rem set "STORAGE_LIFE_RUNTIME_DB=D:\QualityPlatform\OverallR2\data\runtime\storage_runtime.sqlite3"
rem set "STORAGE_KNOWLEDGE_REPOSITORY_DIR=D:\QualityPlatform\OverallR2\data\knowledge_repository"
rem set "STORAGE_KNOWLEDGE_RELEASE_DIR=D:\QualityPlatform\OverallR2\data\knowledge_release\current"

rem Overall R2 always binds Storage to the package's shared Unified Runtime and
rem config\runtime\model.yaml. Do not point UNIFIED_AGENT_RUNTIME_ROOT at a second Runtime.

