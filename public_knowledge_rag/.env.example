OPENAI_COMPATIBLE_PROTOCOL=chat_completions
OPENAI_COMPATIBLE_MODEL=
# Supply the secret through the environment or the write-only Settings page; never put a real key in this file.
OPENAI_COMPATIBLE_API_KEY=
GENERATION_TEMPERATURE=0
MAX_SOURCE_BYTES=8388608
CHUNK_SIZE=1200
CHUNK_OVERLAP=120
