# Non-secret, measured remote model configuration. No credentials are required for LAN Ollama.
OLLAMA_URL=http://192.168.1.100:11434
OLLAMA_MODEL=qwen3-vl:8b-thinking-q4_K_M
OLLAMA_MODEL_DIGEST=901cae73216286ea8c5aba8b46d307ff7188f737285ec500c795a12f05225d28
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_NUM_PREDICT=512
OLLAMA_THINKING_MODE=disabled
GENERATION_PROVIDER=ollama
# To use OpenAI Compatible, set GENERATION_PROVIDER=openai_compatible and configure all fields below.
